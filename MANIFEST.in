include README.md CHANGELOG.md requirements.txt .gitignore MANIFEST.in uv.lock .python-version THIRD_PARTY_NOTICES.md
include LICENSE*
recursive-include licenses *.txt
recursive-include .github *.yml
recursive-include src *.py *.md
recursive-include configs *.example.toml
recursive-include docs *.md
recursive-include notebooks *.ipynb
recursive-include scripts *.py
recursive-include tests *.py
prune data
prune outputs
prune private
prune legacy
prune playground
prune debug
prune other_pipelines
prune src/dare_wearables/outputs
prune src/gp_pipeline/outputs
prune src/ravenna_pipeline/outputs
global-exclude *.local.* *.private.* *.py[cod] .DS_Store .env .env.* *.csv *.tsv *.xlsx *.xls *.parquet *.parq *.bin *.BIN *.omx *.OMX *.pdf *.pem *.key *.log
